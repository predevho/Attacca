# BFF(Next 서버)가 Spring을 호출할 주소. 서버 전용(NEXT_PUBLIC_ 금지).
BE_BASE_URL=http://localhost:8080

# 채팅 STOMP WebSocket 주소. 클라이언트가 BE에 직접 연결하므로 NEXT_PUBLIC_ 필요.
# 배포 시 wss://... 로 설정. 미설정 시 코드 기본값 ws://localhost:8080/ws 사용.
NEXT_PUBLIC_BE_WS_URL=ws://localhost:8080/ws

# 카카오 소셜 로그인 (서버 전용, NEXT_PUBLIC_ 금지)
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=http://localhost:3000/api/bff/oauth/kakao/callback
