# docker-compose.prod.yml 용 환경 파일 예시.
#   cp .env.prod.example .env.prod  후 값을 채운다.
# .env.prod 는 커밋하지 않는다. 각 변수의 설명은 docs/DEPLOY.md 참고.

# --- 인프라 ---
SERVER_NAME=attaca.example.com
PUBLIC_ORIGIN=https://attaca.example.com

# --- DB (RDS) ---
DB_URL=jdbc:mysql://<rds-endpoint>:3306/attaca
DB_USERNAME=attaca
DB_PASSWORD=

# --- 보안 ---
# 32자 이상 무작위. 예: openssl rand -base64 48
JWT_SECRET=

# --- 카카오 ---
# Redirect URI는 카카오 개발자 콘솔에도 같은 값을 등록해야 한다
# (앱 → 플랫폼 키 → REST API 키 /config/callback).
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- 프론트엔드 ---
# ⚠️ NEXT_PUBLIC_* 은 빌드 시점에 번들에 박힌다. 바꾸면 이미지를 다시 빌드해야 한다.
NEXT_PUBLIC_BE_WS_URL=wss://attaca.example.com/ws

# --- 파일 저장 ---
# local: 컨테이너 볼륨에 저장(be-uploads). s3: 아래 값들이 필요하다.
STORAGE_TYPE=local
S3_BUCKET=
S3_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
