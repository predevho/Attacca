# docker-compose.prod.yml 용 환경 파일 예시.
#   cp .env.prod.example .env.prod  후 값을 채운다.
# .env.prod 는 커밋하지 않는다. 각 변수의 설명은 docs/DEPLOY.md 참고.

# --- 접속 주소 ---
# 1단계(IP + HTTP): EC2 퍼블릭 IP. ⚠️ Elastic IP를 할당할 것 —
# 인스턴스를 중지했다 켜면 IP가 바뀌고, NEXT_PUBLIC_BE_WS_URL은 빌드에 박혀 있어
# 채팅이 조용히 죽는다.
# 2단계(도메인 + HTTPS) — 현재 구성.
PUBLIC_ORIGIN=https://attacca.example.com
# 브라우저가 BE WebSocket에 직접 연결할 수 있는 origin 목록(쉼표 구분).
# API 주소가 아니라 웹 페이지의 출처를 적는다. 운영에서 새 웹 도메인을 열 때만 추가한다.
WS_ALLOWED_ORIGINS=https://attacca.example.com,https://www.attacca.example.com
SERVER_NAME=attacca.example.com
CERTBOT_EMAIL=you@example.com     # 인증서 만료 알림을 받을 주소
# 1단계(IP + HTTP)로 되돌린다면: PUBLIC_ORIGIN=http://<Elastic IP>

# --- DB (RDS) ---
DB_URL=jdbc:mysql://<rds-endpoint>:3306/attacca
DB_USERNAME=attacca
DB_PASSWORD=

# --- 어드민 ---
# 기동 시 ADMIN으로 올릴 loginId(쉼표 구분). 첫 어드민을 만드는 유일한 경로다.
# 올리기만 하고 내리지는 않는다. 없는 loginId는 경고만 남기고 기동을 막지 않는다.
# 승격 후에는 본인이 다시 로그인해야 반영된다(access 토큰 30분).
ADMIN_LOGIN_IDS=

# --- 보안 ---
# 32자 이상 무작위. 예: openssl rand -base64 48
JWT_SECRET=

# --- 이미지 (선택) ---
# 평소에는 건드릴 일이 없다. GitHub Actions가 GHCR에 :latest 를 올리고
# systemd 타이머가 그걸 받아 간다.
# 롤백할 때만 IMAGE_TAG에 되돌릴 커밋 sha를 넣는다:
#   IMAGE_TAG=<sha> ./deploy/dc.sh up -d --no-build
# BE_IMAGE=ghcr.io/predevho/attacca-be
# FE_IMAGE=ghcr.io/predevho/attacca-fe
# IMAGE_TAG=latest

# --- 프론트엔드 ---
# ⚠️ NEXT_PUBLIC_* 은 빌드 시점에 번들에 박힌다.
# 평소 이미지는 CI가 굽고 이 값은 저장소 Variables의 NEXT_PUBLIC_BE_WS_URL에서
# 온다. 여기 값은 GHCR이 막혀 서버에서 직접 구울 때(`up -d --build`)만 쓰인다.
# 2단계는 wss://. (1단계였다면 ws://)
NEXT_PUBLIC_BE_WS_URL=wss://attacca.example.com/ws

# --- 카카오 (선택) ---
# 비워 두면 자체 로그인만 쓴다. 채워 넣을 때는 카카오 개발자 콘솔의
# Redirect URI에 <PUBLIC_ORIGIN>/api/bff/oauth/kakao/callback 을 등록해야 한다
# (앱 → 플랫폼 키 → REST API 키 /config/callback).
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- 외부 반입 (선택) ---
# KOPIS Open API 인증키. 비워 두면 KOPIS 공연 수집은 건너뛴다.
KOPIS_SERVICE_KEY=
# 대학 게시판 요청 User-Agent에 표시할 운영 연락처(메일 또는 URL).
IMPORT_CONTACT=

# --- 파일 저장 ---
# local: 컨테이너 볼륨(be-uploads)에 저장. 단일 인스턴스라 이걸로 충분하다.
# s3로 바꾸려면 아래 값들이 필요하다.
STORAGE_TYPE=local
S3_BUCKET=
S3_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
